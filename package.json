{
  "name": "api-rate-limiter",
  "version": "1.0.0",
  "description": "Production-grade API Rate Limiter with Sliding Window algorithms, Redis-backed atomic operations, and comprehensive monitoring",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.ts",
    "test:unit": "jest --config jest.config.ts --testPathPattern=unit",
    "test:integration": "jest --config jest.config.ts --testPathPattern=integration",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "benchmark": "ts-node benchmarks/benchmark.ts",
    "cli:inspect": "ts-node src/cli/inspect.ts",
    "lint": "eslint src/ --ext .ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "rate-limiter",
    "sliding-window",
    "redis",
    "express",
    "middleware",
    "token-bucket",
    "api-gateway"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "prom-client": "^15.1.0",
    "uuid": "^9.0.0",
    "dotenv": "^16.3.1",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  }
}
