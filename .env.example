# Server
PORT=3000
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rl:

# Rate Limiter Defaults
DEFAULT_WINDOW_MS=900000
DEFAULT_MAX_REQUESTS=100

# Failover Strategy: 'fail-open' or 'fail-closed'
REDIS_FAILOVER_STRATEGY=fail-open

# Clock Skew Tolerance (ms)
CLOCK_SKEW_TOLERANCE_MS=1000

# Metrics
METRICS_ENABLED=true
